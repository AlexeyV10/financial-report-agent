  "operations": [
    {
      "operation_id": "direct_fact_v1",
      "formula": "value",
      "result_kind": "amount",
      "rounding": "exact_input_decimal",
      "preconditions": "One verified fact; duration only for these definitions.",
      "production_status": "planned_except_legacy_annual_growth"
    },
    {
      "operation_id": "absolute_change_v1",
      "formula": "current - previous",
      "result_kind": "amount",
      "rounding": "exact_finite_decimal",
      "preconditions": "Same definition, currency, scale, reporting basis; comparable ordered periods.",
      "production_status": "planned_except_legacy_annual_growth"
    },
    {
      "operation_id": "relative_change_v1",
      "formula": "(current / previous - 1) * 100",
      "result_kind": "percent",
      "rounding": "HALF_UP_2",
      "preconditions": "Same context, previous > 0; zero or negative base unsupported.",
      "production_status": "planned_except_legacy_annual_growth"
    },
    {
      "operation_id": "annual_growth_v1",
      "formula": "(current / previous - 1) * 100",
      "result_kind": "percent",
      "rounding": "HALF_UP_2",
      "preconditions": "Legacy operation keeps its existing scope/meaning; two consecutive full calendar years; reference only here.",
      "production_status": "planned_except_legacy_annual_growth"
    },
    {
      "operation_id": "scale_v1",
      "formula": "value * source_scale / target_scale",
      "result_kind": "amount",
      "rounding": "exact_finite_decimal",
      "preconditions": "Only same-currency powers-of-ten scale conversion; no FX rate.",
      "production_status": "planned_except_legacy_annual_growth"
    },
    {
      "operation_id": "operating_margin_v1",
      "formula": "operating_profit / revenue * 100",
      "result_kind": "percent",
      "rounding": "HALF_UP_2",
      "preconditions": "Same entity/standard/period/exact document; revenue > 0; profit may be negative.",
      "production_status": "planned_except_legacy_annual_growth"
    },
    {
      "operation_id": "margin_change_pp_v1",
      "formula": "current_margin_pct - previous_margin_pct",
      "result_kind": "percentage_point",
      "rounding": "HALF_UP_2",
      "preconditions": "Diagnostic method only, four compatible monetary inputs; not relative percent change.",
